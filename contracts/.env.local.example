# =======================================================================
# WAVE-5 DEPLOYMENT CONFIGURATION - TESTNETS ONLY
# =======================================================================
# IMPORTANT: DO NOT COMMIT THIS FILE WITH REAL PRIVATE KEYS!
# This is an EXAMPLE file. Copy to .env.local and fill in your values.
# 
# Security rules:
#   - NEVER commit private keys to git
#   - Use separate wallets for testnet vs mainnet
#   - Keep mainnet credentials secure (multi-sig recommended)
# =======================================================================

# -----------------------------------------------------------------------
# BASE SEPOLIA TESTNET (Stage 1 rehearsal, chain id: 84532)
# -----------------------------------------------------------------------
# Get RPC endpoint from:
#   - Alchemy: https://www.alchemy.com/
#   - QuickNode: https://www.quicknode.com/
#   - Infura: https://infura.io/
RPC_URL_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployer wallet (must have some ETH for gas fees)
# Generate new wallet if needed: cast wallet new --mnemonic-length 12
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Bond sink address (protocol treasury / multi-sig contract)
# For testing, can be any non-zero address
BOND_SINK=0x5f8900a6fd1932df4feac9e36f1f896b8e6fb4f1802484e94a2652d037870d3c

# Bond amount per deployment (default: 1 ETH)
# Override if needed: BOND_AMOUNT=0.01ether
# BOND_AMOUNT=1ether

# Git commit hash (auto-set during CI builds)
COMMIT_HASH=local-dev

# -----------------------------------------------------------------------
# ROBINHOOD TESTNET (Stage 2 rehearsal, chain id: 46630)
# -----------------------------------------------------------------------
# Robinhood testnet RPC (internal network)
RPC_URL_ROBINHOOD_TESTNET=https://robinhood-testnet.internal.example.com/rpc

# Same deployer wallet or separate one
# PRIVATE_KEY_ROBINHOOD=0xOTHER_WALLET_PRIVATE_KEY

# Separate bond sink for Robinhood if needed
# BOND_SINK_ROBINHOOD=0xROBINHOOD_TREASURY_ADDRESS

# -----------------------------------------------------------------------
# ADDITIONAL OPTIONS
# -----------------------------------------------------------------------
# Gas price limit (wei)
GAS_PRICE_LIMIT=1000000000

# Max fee per gas (EIP-1559)
MAX_PRIORITY_FEE_PER_GAS=1000000000
MAX_FEE_PER_GAS=2000000000

# Nonce management (optional, manual override)
# MANUAL_NONCE=0

# Etherscan API key for verification
ETHERSCAN_API_KEY=your_etherscan_api_key

