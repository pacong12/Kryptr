# --- API (@kryptr/api) ---
API_PORT=3333
# Comma-separated browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:4300
DATABASE_URL=postgresql://kryptr:kryptr_dev@localhost:5432/kryptr
REDIS_URL=redis://localhost:6379

# --- Chain integration (phase 1) ---
# RPC endpoints; NEVER put private keys in env reachable by the app.
# Chain reads: 'static' = deterministic mock (default, zero network);
# 'viem' = real reads via RPC_URL_BASE (Base, chainId 8453).
CHAIN_MODE=static
RPC_URL_BASE=
RPC_URL_ROBINHOOD_CHAIN=
BLOCKSCOUT_URL=

# --- Wave-3 adapters (keyed, optional) ---
# DEX aggregator source: 'static-mock' (default) or 'zero-ex' (needs key).
DEX_SOURCE=static-mock
# ZEROX_API_KEY=
# Price feed: 'static' (dev) or 'coingecko' (default; fail-closed without key).
PRICE_FEED_MODE=coingecko
# COINGECKO_API_KEY=

# --- Security ---
# JWT secret for backoffice sessions; generate with: openssl rand -hex 32
AUTH_SECRET=

# --- Frontoffice (@kryptr/frontoffice) ---
VITE_API_URL=http://localhost:3333

# --- Backoffice (@kryptr/backoffice) ---
NEXT_PUBLIC_API_URL=http://localhost:3333
