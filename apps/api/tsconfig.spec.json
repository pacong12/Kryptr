{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "types": ["jest", "node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "jest.smoke.cts",
    "jest.live.cts",
    "jest.workers.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.smoke.ts",
    "src/**/*.live.ts",
    "src/**/*.workers.ts",
    "src/test/**/*.ts",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
